---
import Layout from '../layouts/Layout.astro'
import Plate from '../components/Plate.astro'
import { samples, sourceHash, groups, NATIVE_COUNT, DETECTED_KEYWORD_COUNT, GOLDEN_CASE_COUNT, type Sample } from '../data/samples'

const unported = ['sankey-beta', 'error', 'flowchart-elk']
let plateNumber = 0
---
<Layout
  title="Diagram syntaxes — Etassia"
  description="The Mermaid diagram syntaxes Etassia supports: 22 diagram types rendered natively by the Rust runtime, with the detected-but-unported boundary stated explicitly."
>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 py-14">
    <header class="max-w-3xl">
      <p class="block-label">The catalogue</p>
      <h1 class="display mt-3 text-4xl leading-tight">Supported diagram syntaxes</h1>
      <p class="mt-5 leading-relaxed text-ink-soft dark:text-ink-soft-dark">
        A diagram source that reaches Etassia passes through two stages before any renderer runs.
        The detector first recognizes which of the {DETECTED_KEYWORD_COUNT} Mermaid diagram
        keywords the source uses; the parse stage then reads the body of the source with the
        grammar entry for that type. This page lists every detected type as a plate with its
        source sample and, where a native renderer exists, the SVG that the engine produces for it.
      </p>
      <p class="mt-4 leading-relaxed text-ink-soft dark:text-ink-soft-dark">
        The boundary of the current release is stated explicitly rather than left to be
        discovered. This release renders {NATIVE_COUNT} diagram types natively, and the detected
        types {unported.map((k) => (
          <><code class="font-mono text-sm px-1 py-0.5 rounded-plate bg-rule/50 dark:bg-rule-dark/50">{k}</code>{' '}</>
        ))}
        return an Unported condition, which the runtime bindings translate into a fallback call to
        the reference Ruby implementation. Every plate on this page is a verbatim copy of the
        golden-corpus reference output, and the corpus test asserts byte-identical equality
        between this output and the Rust runtime for each of the
        {GOLDEN_CASE_COUNT.toLocaleString('en-US')} cases. Each plate's hash is the first eight
        characters of the SHA-256 digest of its source, so the catalogue identifies every drawing
        by the exact text that produced it.
      </p>
    </header>

    {groups.map((group) => (
      <section class="mt-14" aria-labelledby={`group-${group.key}`}>
        <div class="dimension-rule" aria-hidden="true"></div>
        <h2 id={`group-${group.key}`} class="display mt-6 text-2xl">{group.heading}</h2>
        <p class="mt-2 max-w-3xl leading-relaxed text-ink-soft dark:text-ink-soft-dark">{group.blurb}</p>

        <div class="mt-8 grid grid-cols-1 xl:grid-cols-2 gap-8">
          {samples.filter((s) => s.group === group.key).map((sample: Sample) => {
            plateNumber += 1
            const number = String(plateNumber).padStart(2, '0')
            return (
              <div class="min-w-0" id={sample.id}>
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h3 class="display text-lg">{sample.name}</h3>
                  {sample.native
                    ? <span class="stamp stamp-native">Native</span>
                    : <span class="stamp stamp-fallback">Unported</span>}
                </div>
                <p class="hash-label mt-1">{sample.keywords}</p>
                <p class="mt-3 leading-relaxed text-ink-soft dark:text-ink-soft-dark">{sample.purpose}</p>

                <details class="mt-3">
                  <summary class="text-sm font-medium text-pen dark:text-pen-dark cursor-pointer select-none">Show the diagram source</summary>
                  <div class="plate mt-3">
                    <pre class="plate-canvas !bg-none font-mono text-xs leading-relaxed whitespace-pre overflow-x-auto max-h-64"><code>{sample.source.trim()}</code></pre>
                  </div>
                </details>

                {sample.svg ? (
                  <Plate
                    number={number}
                    name={sample.name}
                    hash={sourceHash(sample)}
                    status={sample.native ? 'native' : undefined}
                    src={sample.svg}
                    alt={`${sample.name} rendered from the Mermaid sample above`}
                    maxWidth="100%"
                    caption="Byte-identical to the golden-corpus reference output of the Ruby implementation."
                  />
                ) : (
                  <div class="plate mt-4">
                    <div class="p-5 text-sm leading-relaxed border-l-2 border-ochre dark:border-ochre-dark">
                      <span class="stamp stamp-fallback">Unported</span>
                      <p class="mt-3">
                        No plate is shown for this type, because the Rust runtime has no renderer
                        for it in the current release. A caller that receives the Unported
                        condition renders the source with the reference Ruby implementation
                        instead.
                      </p>
                    </div>
                  </div>
                )}
              </div>
            )
          })}
        </div>
      </section>
    ))}

    <section class="mt-16">
      <div class="plate">
        <div class="p-6 sm:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-5">
          <div class="max-w-2xl">
            <h2 class="display text-xl">Run the engine on your own source</h2>
            <p class="mt-2 leading-relaxed text-ink-soft dark:text-ink-soft-dark">
              The playground runs the same WebAssembly build of the engine in the browser. It
              places an editor beside the plate, and every keystroke re-renders the drawing
              through the same boundary the bindings use.
            </p>
          </div>
          <a href="/playground" class="btn btn-primary shrink-0">Open the playground</a>
        </div>
      </div>
    </section>
  </article>
</Layout>
