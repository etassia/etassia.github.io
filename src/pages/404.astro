---
import Layout from '../layouts/Layout.astro'
---
<Layout title="Page not found — Etassia" noindex>
  <article class="max-w-2xl mx-auto px-4 py-24 text-center">
    <p class="text-6xl font-bold text-primary-600 dark:text-primary-400">404</p>
    <h1 class="mt-4 text-2xl font-semibold text-gray-900 dark:text-white">This page does not exist</h1>
    <p class="mt-3 text-gray-600 dark:text-gray-300 leading-relaxed">
      The address does not match a page of this site. The home page carries the overview of the
      engine, the syntax page lists the supported diagram types, and the playground renders
      Mermaid source in the browser.
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary">Go to the home page</a>
      <a href="/syntax" class="btn btn-secondary">Browse the syntaxes</a>
    </div>
  </article>
</Layout>
