---
import Layout from '../layouts/Layout.astro'
---
<Layout title="Page not found — Etassia" noindex>
  <article class="max-w-2xl mx-auto px-4 py-24 text-center">
    <div class="plate inline-block text-left min-w-0 w-full max-w-md">
      <div class="title-block !border-t-0 !border-b border-rule dark:border-rule-dark">
        <span class="field"><span class="block-label">Sheet</span><span class="hash-label">not in the set</span></span>
        <span class="field ml-auto"><span class="stamp stamp-fallback">404</span></span>
      </div>
      <div class="p-8">
        <h1 class="display text-2xl">This address does not match a page of this site</h1>
        <p class="mt-4 leading-relaxed text-ink-soft dark:text-ink-soft-dark">
          The home page carries the overview of the engine, the syntax page lists the supported
          diagram types, and the playground renders diagram source in the browser.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/" class="btn btn-primary">Go to the home page</a>
          <a href="/syntax" class="btn btn-secondary">Browse the syntaxes</a>
        </div>
      </div>
    </div>
  </article>
</Layout>
