---
import Layout from '../layouts/Layout.astro'
import Plate from '../components/Plate.astro'
import { samples, sourceHash, NATIVE_COUNT, DETECTED_KEYWORD_COUNT, GOLDEN_CASE_COUNT } from '../data/samples'
import { readFileSync } from 'node:fs'

const hero = samples.find((s) => s.id === 'flowchart')!
const pie = samples.find((s) => s.id === 'pie')!
const heroSvg = readFileSync('public/diagrams/flowchart.svg', 'utf-8').replace(/width="[^"]*"/, 'width="100%"')

const measures = [
  { value: String(DETECTED_KEYWORD_COUNT), label: 'Mermaid diagram keywords recognized by the detector' },
  { value: String(NATIVE_COUNT), label: 'Mermaid diagram types rendered natively by the Rust runtime' },
  { value: GOLDEN_CASE_COUNT.toLocaleString('en-US'), label: 'golden-corpus cases rendered byte-identically' },
]

const runtimes = [
  {
    runtime: 'Rust',
    pkg: 'etassia',
    install: 'cargo add etassia',
    href: 'https://crates.io/crates/etassia',
    role: 'The rendering runtime, with the checksummed parse artifact baked into the binary.',
  },
  {
    runtime: 'Ruby',
    pkg: 'etassia',
    install: 'gem install etassia',
    href: 'https://rubygems.org/gems/etassia',
    role: 'The pure-Ruby reference implementation, which every release is validated against.',
  },
  {
    runtime: 'Ruby native',
    pkg: 'etassia-native',
    install: 'gem install etassia-native',
    href: 'https://rubygems.org/gems/etassia-native',
    role: 'The compiled engine as a shared library that Ruby loads through Fiddle.',
  },
  {
    runtime: 'Python',
    pkg: 'etassia',
    install: 'pip install etassia',
    href: 'https://pypi.org/project/etassia/',
    role: 'A ctypes binding over the C ABI of the shared library.',
  },
  {
    runtime: 'JavaScript',
    pkg: 'etassia',
    install: 'npm install etassia',
    href: 'https://www.npmjs.com/package/etassia',
    role: 'The engine compiled to WebAssembly, with no JavaScript-side reformatting.',
  },
]
---
<Layout
  description={`Etassia renders ${DETECTED_KEYWORD_COUNT} Mermaid diagram keywords into SVG from a Rust runtime, and ${GOLDEN_CASE_COUNT.toLocaleString('en-US')} golden-corpus cases prove the output byte-identical across the Ruby, Rust, Python, and WebAssembly runtimes.`}
>
  <!-- ============ Hero: the thesis, stated as the engine states it ============ -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-16 pb-10">
    <p class="block-label">Etassia &middot; from the Greek &#7940;&#954;&#964;&#940;&#963;&#963;&#969;, drawn up in formation</p>
    <h1 class="display mt-4 text-4xl sm:text-5xl lg:text-[3.4rem] leading-[1.06] max-w-4xl">
      One diagram source, identical SVG on every runtime.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft dark:text-ink-soft-dark">
      Etassia is a diagram-rendering engine for the Mermaid and PlantUML syntax families, and its
      registry is designed to carry the families after them — including diagrams derived from
      models such as XML Schema, JSON Schema, UML, and EXPRESS. It reads diagram source text and
      produces SVG output from a Rust runtime whose parse artifact is compiled ahead of time and
      checksummed, which makes the output a function of the source alone. A golden corpus of {GOLDEN_CASE_COUNT.toLocaleString('en-US')} Mermaid cases holds
      that promise to the standard of byte-identical equality, so the Ruby, Python, and
      WebAssembly bindings are interchangeable parts rather than lookalikes.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/playground" class="btn btn-primary">Open the playground</a>
      <a href="/syntax" class="btn btn-secondary">Browse the supported syntaxes</a>
    </div>
  </section>

  <!-- ============ Specimen: the source, the boundary, the plate ============ -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-14" aria-label="A rendered specimen">
    <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr_1.4fr] gap-6 items-stretch">
      <div class="plate self-start min-w-0" style="max-width: 30rem">
        <div class="title-block !border-t-0 !border-b border-rule dark:border-rule-dark">
          <span class="field"><span class="block-label">Diagram source</span><span class="hash-label">Mermaid text</span></span>
        </div>
        <pre class="plate-canvas !bg-none font-mono text-[0.78rem] leading-relaxed whitespace-pre overflow-x-auto"><code>{hero.source.trim()}</code></pre>
      </div>

      <div class="hidden lg:flex flex-col items-center justify-center gap-2 py-10" aria-hidden="true">
        <svg width="54" height="12" viewBox="0 0 54 12" class="abi-arrow"><path d="M0 6h48" stroke="currentColor" stroke-width="1.5" /><polygon points="54,6 46,2 46,10" fill="currentColor" /></svg>
        <span class="block-label !tracking-[0.18em]">etassia_render</span>
        <span class="hash-label">one of the three C ABI functions</span>
      </div>

      <div class="min-w-0">
        <Plate
          number="01"
          name="Flowchart"
          hash={sourceHash(hero)}
          status="native"
          inline
          maxWidth="100%"
          caption="This plate is a byte-identical copy of the engine's golden-corpus output. The hash is the first eight characters of the SHA-256 digest of the source on the left, so the same text always yields this same drawing."
        >
          <div class="plate-draw" set:html={heroSvg} />
        </Plate>
      </div>
    </div>
  </section>

  <!-- ============ The measurement rule ============ -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-14" aria-label="Measured scope">
    <div class="dimension-rule" aria-hidden="true"></div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-x-10 gap-y-6 mt-6">
      {measures.map((m) => (
        <div class="border-l-2 border-pen dark:border-pen-dark pl-4">
          <p class="display text-3xl">{m.value}</p>
          <p class="mt-1 text-sm leading-relaxed text-graphite dark:text-graphite-dark">{m.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ Why: the defect the engine removes ============ -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-14">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
      <div class="prose max-w-none lg:pr-6">
        <h2>The problem Etassia removes</h2>
        <p>
          Documentation pipelines mix languages. A static-site generator written in Ruby, a
          specification toolchain written in Python, and a documentation server written in Rust or
          JavaScript can each need to render the same diagram source, and a diagram that differs
          between those pipelines is a defect that is difficult to attribute. Etassia addresses
          this problem by keeping one Rust runtime as the rendering engine, by exposing it through
          bindings that share a single native boundary, and by validating the output of every
          diagram type against the reference implementation rather than against a visual
          impression of it.
        </p>
        <h2>What the runtime guarantees</h2>
        <ul>
          <li>
            The parse tree comes from a checksummed grammar artifact that is compiled ahead of
            time, so parsing does not depend on a grammar interpreter at run time.
          </li>
          <li>
            Every natively rendered diagram type has a hand-ported renderer, and its SVG is
            byte-identical to the reference Ruby implementation on the golden corpus.
          </li>
          <li>
            A diagram type without a native renderer reports an Unported condition through the
            same error surface, which the bindings translate into a fallback call to the
            reference implementation.
          </li>
        </ul>
        <p>
          The boundary itself is small enough to read in one line. Three C functions &mdash;
          <code>etassia_render</code>, <code>etassia_detect</code>, and <code>etassia_free</code>
          &mdash; carry every diagram between the runtime and its bindings: Python reaches them
          through ctypes, WebAssembly exports them over linear memory, and the
          <code>etassia-native</code> gem loads the shared library through Fiddle.
        </p>
      </div>
      <div class="min-w-0">
        <Plate
          number="02"
          name="Pie chart"
          hash={sourceHash(pie)}
          status="native"
          src={pie.svg}
          alt="A pie chart of pets adopted by volunteers, rendered from Mermaid syntax"
          maxWidth="100%"
          caption="A pie chart from the same corpus. The slices, the labels, and the legend come from the pie renderer of the Rust runtime, in the same bytes that the Ruby reference produces."
        />
      </div>
    </div>
  </section>

  <!-- ============ Parts list: the runtimes ============ -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-16">
    <p class="block-label">Parts list</p>
    <h2 class="display mt-2 text-2xl">Every runtime ships through its own registry</h2>
    <p class="mt-3 max-w-2xl leading-relaxed text-ink-soft dark:text-ink-soft-dark">
      Each package carries the plain name <code class="font-mono text-sm px-1 py-0.5 rounded-plate bg-rule/50 dark:bg-rule-dark/50">etassia</code> in
      its registry, and the compiled-engine gem for Ruby is named
      <code class="font-mono text-sm px-1 py-0.5 rounded-plate bg-rule/50 dark:bg-rule-dark/50">etassia-native</code>.
    </p>
    <div class="plate mt-6 overflow-x-auto">
      <table class="w-full text-sm min-w-[44rem]">
        <caption class="sr-only">The five Etassia packages, with install commands and registry links</caption>
        <thead>
          <tr class="border-b border-ink dark:border-ink-dark text-left">
            <th class="py-3 px-4 block-label !tracking-[0.12em]">Runtime</th>
            <th class="py-3 px-4 block-label !tracking-[0.12em]">Package</th>
            <th class="py-3 px-4 block-label !tracking-[0.12em]">Role</th>
            <th class="py-3 px-4 block-label !tracking-[0.12em]">Install</th>
          </tr>
        </thead>
        <tbody class="font-serif">
          {runtimes.map((r) => (
            <tr class="border-b border-rule dark:border-rule-dark last:border-b-0 align-top">
              <td class="py-3.5 px-4 font-medium whitespace-nowrap">{r.runtime}</td>
              <td class="py-3.5 px-4">
                <a href={r.href} target="_blank" rel="noopener noreferrer" class="font-mono text-[0.8rem] text-pen dark:text-pen-dark underline-offset-2 hover:underline">{r.pkg}</a>
              </td>
              <td class="py-3.5 px-4 text-ink-soft dark:text-ink-soft-dark leading-relaxed">{r.role}</td>
              <td class="py-3.5 px-4"><code class="font-mono text-[0.78rem] whitespace-nowrap">{r.install}</code></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ============ Syntax handoff ============ -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-8">
    <div class="plate">
      <div class="p-6 sm:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-5">
        <div class="max-w-2xl">
          <h2 class="display text-xl">The full plate catalogue</h2>
          <p class="mt-2 leading-relaxed text-ink-soft dark:text-ink-soft-dark">
            The detector recognizes {DETECTED_KEYWORD_COUNT} Mermaid diagram keywords, and the
            syntax page lists every one of them with a source sample and, where a native renderer
            exists, the rendered plate. The {NATIVE_COUNT} natively rendered types and the
            explicitly stated Unported boundary are shown side by side; the PlantUML family is
            carried by the same engine through the notation registry.
          </p>
        </div>
        <a href="/syntax" class="btn btn-primary shrink-0">See all diagram types</a>
      </div>
    </div>
  </section>
</Layout>
