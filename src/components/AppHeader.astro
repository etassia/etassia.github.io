---
import { ClientRouter } from 'astro:transitions'

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/'

const isActive = (to: string) => pathname === to || pathname.startsWith(to + '/')

const links = [
  { to: '/syntax', label: 'Syntax' },
  { to: '/playground', label: 'Playground' },
  { to: '/about', label: 'About' },
]
---

<header id="site-header" class="sticky top-0 z-40 bg-vellum/85 dark:bg-vellum-dark/85 backdrop-blur border-b border-rule dark:border-rule-dark">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16 gap-6">
      <a href="/" class="flex items-center gap-3 shrink-0" aria-label="Etassia home">
        <!-- The mark is the first diagram the engine draws: two nodes and a directed edge. -->
        <svg width="26" height="26" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <path d="M8 21v-5h16.5v-5" stroke="currentColor" stroke-width="2.4" class="text-ink dark:text-ink-dark" />
          <polygon fill="currentColor" class="text-pen dark:text-pen-dark" points="26.5,8 22.5,11.5 22.5,4.5" />
          <rect x="3" y="21" width="10" height="8" rx="1" stroke="currentColor" stroke-width="2.4" class="text-pen dark:text-pen-dark" />
          <rect x="20" y="3" width="9" height="8" rx="1" stroke="currentColor" stroke-width="2.4" class="text-ink dark:text-ink-dark" />
        </svg>
        <span class="display text-lg tracking-tight">Etassia</span>
      </a>

      <nav class="flex items-center gap-1" aria-label="Main">
        {links.map((link) => (
          <a
            href={link.to}
            aria-current={isActive(link.to) ? 'page' : undefined}
            class:list={[
              'block px-3 py-1.5 rounded-plate text-sm font-medium transition-colors font-display [font-variation-settings:"wdth"_110]',
              isActive(link.to)
                ? 'text-pen dark:text-pen-dark bg-pen/10 dark:bg-pen-dark/10'
                : 'text-ink-soft dark:text-ink-soft-dark hover:text-ink dark:hover:text-ink-dark hover:bg-rule/50 dark:hover:bg-rule-dark/50',
            ]}
          >{link.label}</a>
        ))}
        <button
          id="theme-toggle"
          type="button"
          class="ml-2 h-8 w-8 inline-flex items-center justify-center rounded-plate border border-graphite/50 dark:border-graphite-dark/50 text-ink-soft dark:text-ink-soft-dark hover:text-ink dark:hover:text-ink-dark hover:border-ink dark:hover:border-ink-dark transition-colors"
        >
        </button>
      </nav>
    </div>
  </div>
</header>

<script is:inline>
  // The control cycles system -> light -> dark. The icon and the accessible
  // name always state the current mode, and the pre-paint script in the
  // layout applies the stored choice before first paint on every page.
  (function () {
    var toggle = document.getElementById('theme-toggle')
    if (!toggle) return
    var icons = { system: null, light: null, dark: null }
    var names = { system: 'System color scheme', light: 'Light', dark: 'Dark' }
    ;['system', 'light', 'dark'].forEach(function (mode) {
      var ns = 'http://www.w3.org/2000/svg'
      var svg = document.createElementNS(ns, 'svg')
      svg.setAttribute('width', '15')
      svg.setAttribute('height', '15')
      svg.setAttribute('viewBox', '0 0 24 24')
      svg.setAttribute('fill', 'none')
      svg.setAttribute('stroke', 'currentColor')
      svg.setAttribute('stroke-width', '2')
      svg.setAttribute('stroke-linecap', 'round')
      svg.setAttribute('stroke-linejoin', 'round')
      svg.setAttribute('aria-hidden', 'true')
      var d
      if (mode === 'dark') {
        // a sun: shown while the page is dark, the click brings light
        d = document.createElementNS(ns, 'circle')
        d.setAttribute('cx', '12'); d.setAttribute('cy', '12'); d.setAttribute('r', '4.2')
        svg.appendChild(d)
        var rays = document.createElementNS(ns, 'path')
        rays.setAttribute('d', 'M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7')
        svg.appendChild(rays)
      } else if (mode === 'light') {
        // a moon: shown while the page is light, the click brings dark
        d = document.createElementNS(ns, 'path')
        d.setAttribute('d', 'M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z')
        svg.appendChild(d)
      } else {
        // a display: shown while the theme follows the system
        d = document.createElementNS(ns, 'rect')
        d.setAttribute('x', '3.5'); d.setAttribute('y', '4.5')
        d.setAttribute('width', '17'); d.setAttribute('height', '12'); d.setAttribute('rx', '1.5')
        svg.appendChild(d)
        var stand = document.createElementNS(ns, 'path')
        stand.setAttribute('d', 'M9 20h6')
        svg.appendChild(stand)
      }
      svg.classList.add('hidden')
      icons[mode] = svg
      toggle.appendChild(svg)
    })
    function apply(mode) {
      localStorage.setItem('theme', mode)
      var dark = mode === 'dark' ||
        (mode === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)
      document.documentElement.classList.toggle('dark', dark)
      document.documentElement.dataset.theme = mode
      Object.keys(icons).forEach(function (m) { icons[m].classList.toggle('hidden', m !== mode) })
      toggle.setAttribute('aria-label', 'Color theme: ' + names[mode] + '. Activate to switch to the next mode.')
    }
    apply(document.documentElement.dataset.theme || 'system')
    toggle.addEventListener('click', function () {
      var order = ['system', 'light', 'dark']
      var current = document.documentElement.dataset.theme || 'system'
      apply(order[(order.indexOf(current) + 1) % order.length])
    })
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
      if ((document.documentElement.dataset.theme || 'system') === 'system') apply('system')
    })
  })()
</script>
