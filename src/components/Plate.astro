---
/**
 * A plate: one of the engine's own diagrams, presented on a drawing sheet
 * with the title block an engineering drawing carries. The hash field shows
 * the first eight characters of the SHA-256 digest of the diagram source,
 * so identical sources carry identical plates.
 */
interface Props {
  number?: string
  name?: string
  hash?: string
  status?: 'native' | 'fallback'
  src?: string
  alt?: string
  caption?: string
  maxWidth?: string
  inline?: boolean
}
const { number, name, hash, status, src, alt = '', caption, maxWidth = '42rem', inline = false } = Astro.props
---
<figure class="my-6 min-w-0" style={`max-width: ${maxWidth}`}>
  <div class="plate">
    <div class="plate-canvas">
      {inline ? <slot /> : src && <img src={src} alt={alt} loading="lazy" width="640" height="400" style="height:auto" />}
    </div>
    {(number || name || hash || status) && (
      <div class="title-block">
        {number && <span class="field"><span class="block-label">Plate</span><span class="hash-label">{number}</span></span>}
        {name && <span class="field"><span class="block-label">Type</span><span class="text-sm font-medium">{name}</span></span>}
        {hash && <span class="field"><span class="block-label">Source sha256</span><span class="hash-label">{hash}</span></span>}
        {status === 'native' && <span class="field"><span class="stamp stamp-native">Native</span></span>}
        {status === 'fallback' && <span class="field"><span class="stamp stamp-fallback">Unported</span></span>}
      </div>
    )}
  </div>
  {caption && <figcaption class="mt-2 text-sm leading-relaxed text-graphite dark:text-graphite-dark">{caption}</figcaption>}
</figure>
