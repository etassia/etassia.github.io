---
const year = new Date().getFullYear()

const runtimeLinks = [
  { href: 'https://crates.io/crates/etassia', label: 'crates.io: etassia' },
  { href: 'https://rubygems.org/gems/etassia', label: 'RubyGems: etassia' },
  { href: 'https://rubygems.org/gems/etassia-native', label: 'RubyGems: etassia-native' },
  { href: 'https://pypi.org/project/etassia/', label: 'PyPI: etassia' },
  { href: 'https://www.npmjs.com/package/etassia', label: 'npm: etassia' },
]

const siteLinks = [
  { href: '/syntax', label: 'Diagram syntaxes' },
  { href: '/playground', label: 'Playground' },
  { href: '/about', label: 'About' },
]
---
<footer class="bg-gray-100 dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="col-span-1 md:col-span-2">
        <div class="flex items-center space-x-2.5 mb-4">
          <svg class="h-6 w-6 text-primary-600 dark:text-primary-400" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect x="3" y="21" width="10" height="8" rx="1.5" stroke="currentColor" stroke-width="2.4" />
            <rect x="20" y="3" width="9" height="8" rx="1.5" stroke="currentColor" stroke-width="2.4" />
            <path d="M8 21v-5h16.5v-5" stroke="currentColor" stroke-width="2.4" />
            <polygon fill="currentColor" points="26.5,7 22.5,10.5 22.5,3.5" />
          </svg>
          <span class="text-lg font-bold text-gray-900 dark:text-white">Etassia</span>
        </div>
        <p class="text-gray-600 dark:text-gray-400 max-w-md">
          Etassia is a diagram-rendering engine. It reads Mermaid diagram syntax and produces
          SVG output that is byte-identical across the Ruby, Rust, Python, and WebAssembly
          runtimes.
        </p>
        <p class="mt-3 text-sm text-gray-500 dark:text-gray-400 italic">
          <em>&#7940;&#954;&#964;&#940;&#963;&#963;&#969;</em> &mdash; drawn up in formation.
        </p>
      </div>

      <div>
        <p class="font-semibold text-gray-900 dark:text-white mb-4">Site</p>
        <ul class="space-y-2">
          {siteLinks.map((link) => (
            <li>
              <a href={link.href} class="text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400">{link.label}</a>
            </li>
          ))}
          <li>
            <a href="https://github.com/etassia" target="_blank" rel="noopener noreferrer" class="text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400">GitHub organization</a>
          </li>
        </ul>
      </div>

      <div>
        <p class="font-semibold text-gray-900 dark:text-white mb-4">Packages</p>
        <ul class="space-y-2">
          {runtimeLinks.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-700 flex flex-col md:flex-row justify-between items-center">
      <p class="text-sm text-gray-600 dark:text-gray-400">
        &copy; {year} Ribose. BSD-2-Clause License.
      </p>
    </div>
  </div>
</footer>
